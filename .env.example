# ===== À mettre dans Vercel > Settings > Environment Variables =====
# Publiques (affichées dans le navigateur : OK)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SITE_URL=https://TON-SITE.vercel.app

# SECRÈTES : serveur uniquement, jamais dans Git
SUPABASE_SERVICE_ROLE_KEY=
SASPAY_SECRET_KEY=
SASPAY_WEBHOOK_SECRET=
ABONNEMENT_PRIX_USD=
ABONNEMENT_PRIX_CDF=
ABONNEMENT_DUREE_JOURS=180
# Mode de frais de ton compte SasPay : ADD_ON (défaut) ou DEDUCTED
SASPAY_FEE_MODE=ADD_ON
# Obligatoire seulement si DEDUCTED : pourcentage de frais (ex. 3.5)
SASPAY_FEE_PERCENT=
